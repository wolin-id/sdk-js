{
  "name": "@wolin-id/client",
  "version": "0.1.0",
  "description": "Zero-dependency W3C Solid Pod client, Solid-OIDC PKCE helper, and RFC 9449 ES256 DPoP signer for Wolin",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Entropy Paradox, Inc. (https://wolin.id)",
  "homepage": "https://wolin.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolin-id/sdk-js.git",
    "directory": "packages/client"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "wolin",
    "solid",
    "solid-pod",
    "solid-oidc",
    "dpop",
    "rfc9449",
    "webid",
    "ldp",
    "rdf",
    "turtle"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
