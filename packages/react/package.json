{
  "name": "@wolin-id/react",
  "version": "0.1.0",
  "description": "React hooks and context provider for Wolin Solid Pods (@wolin-id/client)",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "author": "Entropy Paradox, Inc. (https://wolin.id)",
  "homepage": "https://wolin.id",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wolin-id/sdk-js.git",
    "directory": "packages/react"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "wolin",
    "solid",
    "solid-pod",
    "solid-oidc",
    "dpop",
    "react",
    "hooks",
    "webid"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@wolin-id/client": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
